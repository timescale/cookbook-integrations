# Connection string for your Tiger Cloud service.
# Find it in Tiger Cloud Console → your service → "Connection info" → Service URL.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
TIGER_SERVICE_URL=postgres://tsdbadmin:YOUR_PASSWORD@YOUR_HOST.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require

# Optional — Socrata app token for higher API rate limits when running load.py.
# Without one, you'll be throttled at ~1000 requests/hour (still plenty for the
# 16k-row dataset). Get a free token at:
#   https://data.cityofnewyork.us/profile/app_tokens
NYC_APP_TOKEN=

# Optional — page size for the Socrata fetch. Max 50000.
PAGE_SIZE=5000
